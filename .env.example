DATABASE_URL=postgresql://council:council@127.0.0.1:5432/council?schema=public
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
COUNCIL_SCHOOL_ID=school
# Optional restriction; leave empty to allow verified Google accounts.
GOOGLE_ALLOWED_DOMAIN=
# Explicitly demo data only. Disabled by default.
ENABLE_DEMO=false
# Works only in next dev, only demo identities, never in a production build.
ENABLE_DEV_LOGIN=false
# Separate database, never the live council database.
TEST_DATABASE_URL=postgresql://council:council@127.0.0.1:5432/council_test
